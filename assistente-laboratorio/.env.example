# Copia questo file in .env e adatta i valori. Il file .env non va versionato.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# Identificativo restituito da GET /v1/models
LM_STUDIO_MODEL=google/gemma-4-e2b
# Facoltativa (predefinito 6)
#MAX_PASSAGGI=6
# Solo per Docker Compose (predefinito: http://host.docker.internal:1234/v1)
#LM_STUDIO_DOCKER_URL=http://host.docker.internal:1234/v1
# Server MCP delle note (facoltative; predefiniti locali)
#MCP_URL=http://localhost:8001/mcp
# Timeout di discovery e invocazione, in secondi (> 0, predefinito 10)
#MCP_TIMEOUT=10
# Attesa massima all'avvio perché il server MCP risponda, in secondi (>= 0, predefinito 0; in Compose 20)
#MCP_ATTESA_AVVIO=0
