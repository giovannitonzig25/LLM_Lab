# Copia questo file in .env e adatta i valori. Il file .env non va versionato.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# Identificativo restituito da GET /v1/models
LM_STUDIO_MODEL=google/gemma-4-e2b
# Ambito dell'agente: una riga, al massimo 500 caratteri (obbligatoria)
AMBITO_AGENTE=Assistente per attività pratiche quotidiane: data, ora e fusi orari; meteo; calcoli e conversioni di unità; giorni lavorativi e scadenze; ricerca e consultazione del catalogo formativo; gestione delle note personali; saluti, chiarimenti e domande di continuazione riferite alla conversazione; spiegazioni introduttive di concetti informatici, come i protocolli usati dagli assistenti.
# Facoltativa (predefinito 6)
#MAX_PASSAGGI=6
# Correzioni che il Revisore può chiedere all'agente per ogni domanda; 0 = giudizio senza correzioni
#MAX_REVISIONI=1
# Messaggi oltre i quali i turni più vecchi vengono riassunti; si conservano sempre gli ultimi 2 turni (predefinito 20)
#SOGLIA_RIASSUNTO=20
# Solo per Docker Compose (predefinito: http://host.docker.internal:1234/v1)
#LM_STUDIO_DOCKER_URL=http://host.docker.internal:1234/v1
# Server MCP delle note (facoltative; predefiniti locali)
#MCP_URL=http://localhost:8001/mcp
# Timeout di discovery e invocazione, in secondi (> 0, predefinito 10)
#MCP_TIMEOUT=10
# Attesa massima all'avvio perché il server MCP risponda, in secondi (>= 0, predefinito 0; in Compose 20)
#MCP_ATTESA_AVVIO=0
# Solo per Docker Compose (predefiniti: http://server-mcp:8001/mcp e attesa di 20 s)
#MCP_DOCKER_URL=http://server-mcp:8001/mcp
# Servizio HTTP di date e scadenze (facoltative; predefiniti locali)
#SERVIZI_BASE_URL=http://localhost:8000
# Timeout delle richieste al servizio, in secondi (> 0, predefinito 10)
#SERVIZI_TIMEOUT=10
# Solo per Docker Compose (predefinito: http://servizi-http:8000)
#SERVIZI_DOCKER_URL=http://servizi-http:8000
# Servizio HTTP dell'agente (Step 6): indirizzo e porta di ascolto (predefiniti locali)
#AGENTE_HOST=127.0.0.1
#AGENTE_PORT=8002
# Indirizzo dell'agente usato dalla CLI (predefinito locale; in Compose http://agente:8002)
#AGENTE_URL=http://localhost:8002
# Back-end delle chat (Step 7): PostgreSQL in Docker (`docker compose up -d postgres`).
# Valori d'esempio: scegliere una password propria nel file .env.
POSTGRES_USER=assistente
POSTGRES_PASSWORD=cambiami
POSTGRES_DB=chat
# Stesse credenziali di sopra; Compose pubblica PostgreSQL su 127.0.0.1:5433
# (127.0.0.1 e non localhost: su Windows localhost prova prima IPv6 e ogni connessione attende il timeout)
DATABASE_URL=postgresql://assistente:cambiami@127.0.0.1:5433/chat
# Indirizzo e porta di ascolto del back-end (predefiniti locali)
#BACKEND_HOST=127.0.0.1
#BACKEND_PORT=8003
